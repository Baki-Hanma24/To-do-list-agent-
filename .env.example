# Claude
ANTHROPIC_API_KEY=

# Database: Neon Postgres URL on Vercel. Leave empty locally to use an on-disk PGlite DB in .data/
DATABASE_URL=

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The only Google account allowed to sign in
ALLOWED_EMAIL=you@gmail.com

# 32 random bytes, base64 (generate with: openssl rand -base64 32). Encrypts your Google refresh token.
TOKEN_ENC_KEY=

# Local development only: skip Google sign-in (ignored in production)
AUTH_DEV_BYPASS=
